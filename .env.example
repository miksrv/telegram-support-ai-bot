# ============================================================
# Telegram Support AI Bot — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Required
# ----------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to run admin commands
# (/enable, /disable, /event, /context, /status, /stats). Get IDs from
# @userinfobot or similar.
ADMIN_IDS=123456789,987654321

# Chat ID every answered question is forwarded to, with a link back to the
# original message and the asker's profile. Get it from @userinfobot after
# adding the bot to that chat.
ORGANIZERS_CHAT_ID=-1001234567890

# ----------------------------------------------------------
# LLM Engine
# ----------------------------------------------------------
# Which cloud LLM is primary: "openai" or "groq" (default: openai, per this
# bot's spec). Only the API key for the active engine is required below —
# but if you also fill in the other one, it's kept on standby and the bot
# automatically fails over to it if the active engine runs out of
# quota/balance (see core/llm/engine.py). Recommended setup: OpenAI as
# primary, Groq API key filled in as the fallback.

LLM_ENGINE=openai

# OpenAI API key (https://platform.openai.com/api-keys) — required when LLM_ENGINE=openai
OPENAI_API_KEY=your_openai_api_key_here

# Groq API key (https://console.groq.com) — required when LLM_ENGINE=groq,
# optional (but recommended) as a fallback when LLM_ENGINE=openai
GROQ_API_KEY=your_groq_api_key_here

# Optional per-provider model overrides.
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# Optional
# ----------------------------------------------------------

# Past Q&A rows per user injected into the LLM prompt as conversational
# context, across all chats (default: 5).
# USER_HISTORY_LIMIT=5

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
